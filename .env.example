# Phase 4: auto enables CUDA inference on Linux x86_64, and disables it on macOS.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Empty disables authentication. Never commit a real key.
API_KEY=
HEALTH_REQUIRES_AUTH=false

# Local development default; use /var/lib/ltx-server for the systemd example.
DATA_DIR=./data
# Optional overrides; when omitted, each derives from DATA_DIR.
# MODEL_DIR=/var/lib/ltx-server/models
# OUTPUT_DIR=/var/lib/ltx-server/outputs
# TEMP_DIR=/var/lib/ltx-server/tmp
# ASSET_DIR=/var/lib/ltx-server/assets

OUTPUT_TTL_SECONDS=1800
DOWNLOAD_GRACE_SECONDS=300
ASSET_TTL_SECONDS=3600
TEMP_TTL_SECONDS=3600
JOB_RECORD_TTL_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=60
DELETE_AFTER_DOWNLOAD=true

# NVML physical index and CUDA logical device are separate selectors.
GPU_INDEX=0
GPU_DEVICE=cuda:0
MAX_CONCURRENT_GENERATIONS=1
MAX_QUEUE_SIZE=20

# auto | ltx | disabled. Linux: install with uv sync --locked --extra inference.
INFERENCE_BACKEND=auto
LTX_MODEL=ltx-2.5-fast
WARM_MODEL_ON_START=true
USE_FP8=true
CACHE_TEXT_ENCODER=true
# Explicit download script only; the server never downloads models.
HF_TOKEN=
# Defaults derive from MODEL_DIR/ltx-2.5 and the pinned component filenames.
# LTX_TRANSFORMER_PATH=/path/to/ltx-2.5-22b-distilled-transformer-bf16.safetensors
# LTX_TEXT_ENCODER_PATH=/path/to/gemma4-12b-with-proj-ltx-2.5-bf16.safetensors
# LTX_VIDEO_VAE_PATH=/path/to/ltx-2.5-video-vae-conv-bf16.safetensors
# LTX_AUDIO_VAE_PATH=/path/to/ltx-2.5-audio-vae-bf16.safetensors
# LTX_SPATIAL_UPSAMPLER_PATH=/path/to/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors

DEFAULT_RESOLUTION=540p
DEFAULT_DURATION_SECONDS=10
DEFAULT_FPS=24
DEFAULT_GENERATE_AUDIO=true
MAX_DURATION_SECONDS=20
MAX_RESOLUTION=1080p

# MiB. Actual content type determines which limit applies.
MAX_IMAGE_UPLOAD_MB=50
MAX_AUDIO_UPLOAD_MB=100
MAX_VIDEO_UPLOAD_MB=500
MAX_IMAGE_PIXELS=40000000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_PREPARE_TIMEOUT_SECONDS=120
MAX_PREPARED_VIDEO_MB=512
VIDEO_CRF=19
VIDEO_PRESET=veryfast
FFMPEG_STALL_TIMEOUT_SECONDS=60

# Comma-separated exact origins. Empty disables CORS.
CORS_ORIGINS=

# Operator-managed style and IC-LoRA allowlist; restart after manifest edits.
# LORA_MANIFEST=/etc/ltx-server/loras.json
# DEFAULT_IC_LORA=reference

# Optional performance controls. These defaults are not yet benchmarked on the 5090.
# none retains/parks weights; cpu and disk use upstream block streaming.
OFFLOAD_MODE=none
ATTENTION_BACKEND=automatic
COMPILE_TRANSFORMER=false
VAE_TILE_SIZE=512
VAE_TILE_OVERLAP=64
VAE_TEMPORAL_SIZE=80
VAE_TEMPORAL_OVERLAP=24
# Benchmark runner enables synchronized stage boundaries; normal serving leaves this off.
SYNCHRONIZE_TIMINGS=false
